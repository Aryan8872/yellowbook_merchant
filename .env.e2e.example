# E2E Testing Environment Variables
# Copy this file to .env.e2e and fill in the values

# Deployed frontend URL (Vercel)
E2E_BASE_URL=https://yellowbook-merchant.vercel.app

# Test credentials (use test accounts, not production)
E2E_ADMIN_EMAIL=admin@offernepal.com
E2E_ADMIN_PASSWORD=AdminTest123!

E2E_MERCHANT_EMAIL=merchant@offernepal.com
E2E_MERCHANT_PASSWORD=MerchantTest123!

# Backend API URL (Railway) - for direct API tests
E2E_API_URL=https://yellow-bookapi-production.up.railway.app
